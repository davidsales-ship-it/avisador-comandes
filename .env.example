# Contraseñas de acceso (deben ser distintas)
VISOR_PASSWORD=
EMPLEADO_PASSWORD=
# Clave para que otro software use la API (cabecera X-API-Key). Vacía = API externa desactivada
API_KEY=
# Firma de las sesiones: al menos 32 caracteres aleatorios
SECRET_KEY=
# Minutos que un pedido sigue en el visor desde su último aviso (0 = hasta quitarlo a mano)
EXPIRA_MINUTOS=15
# Cifras máximas del número de pedido
MAX_DIGITOS=4
# Pedidos visibles a la vez en el visor (el principal + los de la columna)
MAX_VISIBLES=13
# Fichero SQLite
DB_PATH=avisador.db
# Pon 0 solo para probar en local sin HTTPS
COOKIE_SEGURA=1
